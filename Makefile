####### Compile

main.o: main.cpp mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

board.o: board.cpp board.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o board.o board.cpp

gamewidget.o: gamewidget.cpp gamewidget.h \
		board.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o gamewidget.o gamewidget.cpp

mainwindow.o: mainwindow.cpp mainwindow.h \
		board.h \
		gamewidget.h \
		aboutdialog.h \
		statisticsdialog.h \
		computerworker.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o mainwindow.cpp

computerworker.o: computerworker.cpp computerworker.h \
		board.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o computerworker.o computerworker.cpp

aboutdialog.o: aboutdialog.cpp aboutdialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o aboutdialog.o aboutdialog.cpp

statisticsdialog.o: statisticsdialog.cpp statisticsdialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o statisticsdialog.o statisticsdialog.cpp

moc_gamewidget.o: moc_gamewidget.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_gamewidget.o moc_gamewidget.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_computerworker.o: moc_computerworker.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_computerworker.o moc_computerworker.cpp

moc_aboutdialog.o: moc_aboutdialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_aboutdialog.o moc_aboutdialog.cpp

moc_statisticsdialog.o: moc_statisticsdialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_statisticsdialog.o moc_statisticsdialog.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/local/bin || mkdir -p $(INSTALL_ROOT)/usr/local/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/local/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/local/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/local/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/local/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

